# ============================================
# Astroid Lounge - Environment Variables
# ============================================
# Copy to .env.local and fill in real values.
# NEVER commit .env.local. The Lounge does NOT and MUST NOT touch fiat
# or real-money flows; the only on-chain reads are public balance checks.
#
# ============================================
# PUBLIC SITE URL (used for absolute URLs, OG images, etc.)
# ============================================
NEXT_PUBLIC_SITE_URL=https://lounge.astroid.space

# ============================================
# SUPABASE (separate project from astroid.space - do NOT share)
# Gambling-adjacent infra is isolated by policy. Create a new Supabase
# project for the Lounge with its own URL, anon key, and service role.
# ============================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# SOLANA / TOKEN-GATING
# Mainnet RPC for reading $ASTROID balances. Helius / Quicknode / Triton
# recommended for production; the public RPC works for dev but is
# rate-limited heavily.
# ============================================
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# The $ASTROID SPL token mint. Defaults to the live mint already on
# astroid.space; override only if rotating to a new mint.
NEXT_PUBLIC_TOKEN_MINT=8NwtzwGm4CV8Hm4fJXR69ac1MxDYuSaN3A9HVyikpump

# Minimum $ASTROID balance (raw token units, NOT lamports) required to
# enter freeroll tournaments. Tune via env, no code change required.
NEXT_PUBLIC_TOKEN_GATE_MIN_BALANCE=10000

# ============================================
# PRIZE POOL FUNDING (project treasury wallet)
# Public address only - the Lounge READS the wallet to confirm pools
# are funded. It NEVER signs transactions on the wallet's behalf.
# Prize payouts are signed by an offline / hardware wallet flow you
# control directly; the Lounge only schedules and records them.
# ============================================
NEXT_PUBLIC_TREASURY_WALLET=
PRIZE_POOL_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ============================================
# ADMIN ACCESS
# Long random string (32+ chars). Generate with:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# ============================================
ADMIN_TOKEN=
ADMIN_COOKIE_SECRET=

# ============================================
# GEOBLOCKING (overrides)
# Comma-separated ISO country codes / US state codes to ADD to the
# default blocklist. The defaults already cover OFAC + strict-gambling
# jurisdictions. Use this if a state newly bans sweepstakes-coin
# operators and you need to react before a code update ships.
# ============================================
GEOBLOCK_EXTRA_COUNTRIES=
GEOBLOCK_EXTRA_US_STATES=

# ============================================
# Trusted proxy(s) for IP extraction. Set to "vercel" if deployed on
# Vercel; "cloudflare" if behind Cloudflare. Leave blank for local dev.
# ============================================
TRUSTED_PROXY=cloudflare
